+bool llama_kv_cache::leasepath_usage(const llama_seq_id * active_ids, size_t n_active, llama_leasepath_kv_usage & out) const {
+    out = {};
+    if (n_swa != 0 || layers.empty()) { return false; }
+    for (size_t a = 0; a < n_active; ++a) {
+        if (active_ids[a] < 0 || active_ids[a] >= (llama_seq_id) seq_to_stream.size()) { return false; }
+    }
+    for (const auto & layer : layers) {
+        if (layer.k->type != GGML_TYPE_F16 || layer.v->type != GGML_TYPE_F16 ||
+            ggml_backend_buffer_is_host(layer.k->buffer) || ggml_backend_buffer_is_host(layer.v->buffer)) { return false; }
+        const uint64_t cells = uint64_t(get_size()) * n_stream;
+        const uint64_t payload = ggml_nbytes(layer.k) + ggml_nbytes(layer.v);
+        if (cells == 0 || payload % cells != 0) { return false; }
+        out.bytes_per_cell += payload / cells;
+        out.payload_capacity_bytes += payload;
+    }
+    for (const auto & item : ctxs_bufs) {
+        out.reserved_buffer_bytes += ggml_backend_buffer_get_size(item.second.get());
+    }
+    for (const auto & cells : v_cells) {
+        out.capacity_cells += cells.size();
+        for (uint32_t i = 0; i < cells.size(); ++i) {
+            if (cells.is_empty(i)) { continue; }
+            ++out.resident_cells;
+            if (cells.seq_count(i) > 1) { ++out.shared_cells; }
+            bool active = false;
+            for (size_t a = 0; a < n_active; ++a) {
+                if (cells.seq_has(i, active_ids[a])) { active = true; break; }
+            }
+            if (active) { ++out.active_cells; }
+        }
+    }
+    out.resident_payload_bytes = out.resident_cells * out.bytes_per_cell;
+    out.active_payload_bytes = out.active_cells * out.bytes_per_cell;
+    out.idle_payload_bytes = out.resident_payload_bytes - out.active_payload_bytes;
+    return true;
 }
 
