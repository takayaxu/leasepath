{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LeasePath v2 explicit request attempt",
  "type": "object",
  "required": [
    "request_id",
    "owner",
    "context_version",
    "logical_request_id",
    "attempt_id",
    "purpose",
    "wire_api",
    "retry_of"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "context_version": {
      "type": "string",
      "minLength": 1
    },
    "logical_request_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "enum": [
        "demand",
        "auxiliary_no_demand",
        "auxiliary"
      ]
    },
    "wire_api": {
      "enum": [
        "chat",
        "completion"
      ]
    },
    "retry_of": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
