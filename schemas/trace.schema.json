{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leasepath.local/schemas/trace-v0.1.json",
  "title": "LeasePath event v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "event_id",
    "event_type",
    "ts_ns",
    "clock_domain",
    "evidence_kind",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "enum": [
        "workflow_submit",
        "workflow_end",
        "request_ready",
        "request_enqueue",
        "request_dispatch",
        "cache_lookup",
        "request_end",
        "idle_start",
        "legal_demand",
        "context_retire",
        "observation_end",
        "tool_start",
        "tool_end",
        "resource_snapshot"
      ]
    },
    "ts_ns": {
      "type": "integer",
      "minimum": 0
    },
    "clock_domain": {
      "type": "string",
      "minLength": 1
    },
    "evidence_kind": {
      "enum": [
        "synthetic",
        "measured",
        "replayed"
      ]
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "idle_episode_id": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "tool_start",
              "tool_end"
            ]
          }
        }
      },
      "then": {
        "required": [
          "workflow_id"
        ],
        "properties": {
          "data": {
            "required": [
              "tool_id"
            ],
            "properties": {
              "tool_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "workflow_submit",
              "workflow_end"
            ]
          }
        }
      },
      "then": {
        "required": [
          "workflow_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "request_ready",
              "request_enqueue",
              "request_dispatch",
              "cache_lookup",
              "request_end"
            ]
          }
        }
      },
      "then": {
        "required": [
          "workflow_id",
          "request_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "idle_start",
              "legal_demand",
              "context_retire"
            ]
          }
        }
      },
      "then": {
        "required": [
          "idle_episode_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "idle_start"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "context_id",
              "context_version",
              "compatibility_id",
              "prefix_token_ids"
            ],
            "properties": {
              "context_id": {
                "type": "string"
              },
              "context_version": {
                "type": "string"
              },
              "compatibility_id": {
                "type": "string"
              },
              "prefix_token_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "legal_demand"
          }
        }
      },
      "then": {
        "required": [
          "request_id"
        ],
        "properties": {
          "data": {
            "required": [
              "compatibility_id",
              "request_token_ids"
            ],
            "properties": {
              "compatibility_id": {
                "type": "string"
              },
              "request_token_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "cache_lookup"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "prompt_tokens",
              "cached_tokens",
              "executed_prefill_tokens"
            ],
            "properties": {
              "prompt_tokens": {
                "type": "integer",
                "minimum": 1
              },
              "cached_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "executed_prefill_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "backend_lookup": {
                "type": "object",
                "required": ["prompt_token_ids", "compatibility_id", "source_event_id"],
                "properties": {
                  "prompt_token_ids": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "integer", "minimum": 0}
                  },
                  "compatibility_id": {"type": "string", "minLength": 1},
                  "source_event_id": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "context_retire"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "tool_start",
              "tool_end"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "dependentRequired": {
              "dependency_request_id": [
                "target_request_id"
              ],
              "target_request_id": [
                "dependency_request_id"
              ]
            },
            "properties": {
              "dependency_request_id": {
                "type": "string",
                "minLength": 1
              },
              "target_request_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "request_ready"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "properties": {
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "request_id",
                    "delay_ns"
                  ],
                  "properties": {
                    "request_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "delay_ns": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "cache_lookup"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "dependentRequired": {
              "physical_trace_scope": [
                "block_size_tokens",
                "compatibility_id",
                "prompt_token_ids",
                "physical_blocks"
              ],
              "block_size_tokens": [
                "physical_trace_scope",
                "compatibility_id",
                "prompt_token_ids",
                "physical_blocks"
              ],
              "compatibility_id": [
                "physical_trace_scope",
                "block_size_tokens",
                "prompt_token_ids",
                "physical_blocks"
              ],
              "prompt_token_ids": [
                "physical_trace_scope",
                "block_size_tokens",
                "compatibility_id",
                "physical_blocks"
              ],
              "physical_blocks": [
                "physical_trace_scope",
                "block_size_tokens",
                "compatibility_id",
                "prompt_token_ids"
              ]
            },
            "properties": {
              "physical_trace_scope": {
                "const": "synthetic_complete_lookups"
              },
              "block_size_tokens": {
                "type": "integer",
                "minimum": 1
              },
              "compatibility_id": {
                "type": "string",
                "minLength": 1
              },
              "prompt_token_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "physical_blocks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "block_key",
                    "physical_id",
                    "bytes",
                    "cache_hit"
                  ],
                  "properties": {
                    "block_key": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "physical_id": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4,
                      "prefixItems": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "integer",
                          "minimum": 0
                        },
                        {
                          "type": "integer",
                          "minimum": 0
                        },
                        {
                          "type": "integer",
                          "minimum": 1
                        }
                      ]
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "cache_hit": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
